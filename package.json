{
  "name": "movie-downloader",
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "bun ./src/cli.ts",
    "bundle": "bun build ./src/cli.ts --compile --outfile build/movie-downloader",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@movie-web/providers": "^2.4.13",
    "change-case": "^5.4.4",
    "filenamify": "^7.0.2",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/bun": "^1.3.14",
    "@types/prompts": "^2.4.9",
    "@typescript/native": "npm:typescript@~7.0.2",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@11.18.0"
}
